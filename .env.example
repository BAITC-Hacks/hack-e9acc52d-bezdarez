# Optional: the simulator and deterministic report work without credentials.
# Copy this file to .env in the repository root to enable the LLM analyst.
# Secrets are passed only to the backend; never use VITE_* for API keys.
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=claude-opus-5
AI_DISABLED=false
AI_TIMEOUT_SECONDS=120

# Docker host ports (containers keep their internal ports).
FRONTEND_PORT=8080
BACKEND_PORT=8000

# Used only when accessing the backend from a different browser origin.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
LOG_LEVEL=INFO
