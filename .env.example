# AI (необязательно). Без LLM приложение полностью работает на системной аналитике.
# Ключи читает только backend, в браузер они не передаются.
#
# 1) Локальная модель на своём GPU/CPU через Ollama (OpenAI-совместимый API):
#    ollama serve && ollama pull qwen2.5:7b
LLM_API_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=90
#
# 2) Резерв — NVIDIA API Catalog (build.nvidia.com → Get API Key, ключ nvapi-...).
#    Используется, если локальная модель недоступна; можно задать только его.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Порты Docker (внутренние порты контейнеров не меняются).
FRONTEND_PORT=8080
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
LOG_LEVEL=INFO
