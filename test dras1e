  assert.equal(head.status, 200);
  assert.equal(await head.text(), "");
  assert.ok(Number(head.headers.get("content-length")) > 0);
  for (const target of ["/.env", "/.git/config", "/backend/server.js", "/../.env", "/%2e%2e/.env", "/src/../../package.json", "/%2e%2e%2fpackage.json", "/tests/scenario.test.js", "/Tests/scenario.test.js", "/tests%20/scenario.test.js", "/.artifacts/screenshot.png", "/serve.ps1", "/not-found.css"]) {
    assert.equal((await raw(target)).status, 404, target);
  }
  for (const target of ["/%ZZ", "/..%5c.env", "/src/%00scenario.js"]) assert.equal((await raw(target)).status, 400, target);
  assert.equal((await fetch(`${base}/styles.css`, { method: "POST" })).status, 405);
});

test("disconnecting the caller cancels pending AI work", async (t) => {
  let observedSignal;
  let started;
  const isStarted = new Promise((resolve) => { started = resolve; });
  const { base } = await fixture(t, { analyzeScenario: ({ signal }) => {
    observedSignal = signal;
    started();
    return new Promise((resolve) => signal.addEventListener("abort", () => resolve(unconfigured()), { once: true }));
  } });
  const controller = new AbortController();
  const pending = fetch(`${base}/api/simulate`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ decisions: sample() }), signal: controller.signal });
  await isStarted;
  const aborted = new Promise((resolve) => observedSignal.addEventListener("abort", resolve, { once: true }));
  controller.abort();
  await assert.rejects(pending, { name: "AbortError" });
  await aborted;
  assert.equal(observedSignal.aborted, true);
});


